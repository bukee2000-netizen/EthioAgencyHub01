# =============================================================================
# CLOUDFLARE R2 (File Storage — replaces Telegram)
# =============================================================================
# All documents, passport photos, interview videos, and certificates are
# stored in Cloudflare R2 (S3-compatible). Bucket is auto-created on first use.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ethio-agency-hub
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev  # optional public bucket URL

# Presigned URL expiry (seconds)
R2_PRESIGN_UPLOAD_EXPIRY=3600
R2_PRESIGN_DOWNLOAD_EXPIRY=86400

# Upload size limits (in MB)
R2_PHOTO_MAX_MB=10
R2_VIDEO_MAX_MB=50


# =============================================================================
# SUPABASE (Auth & Database — replaces custom JWT/password/session)
# =============================================================================
# Supabase project URL and anon key (safe for client-side).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key (server-side only — never expose to client).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# =============================================================================
# UPSTASH REDIS (Rate Limiting & Caching)
# =============================================================================
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token


# =============================================================================
# RESEND (Email)
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-domain.com


# =============================================================================
# WHATSAPP BUSINESS API (Notifications)
# =============================================================================
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
